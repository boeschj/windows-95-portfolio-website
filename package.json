        "@payloadcms/storage-s3": "^3.91.0",
        "@react95/fonts": "^1.0.1",
        "@t3-oss/env-nextjs": "^0.13.11",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "graphql": "^16.14.2",
        "next": "16.4.2",
        "payload": "^3.91.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sharp": "^0.35.5",
        "shiki": "^4.5.0",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
