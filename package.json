{
    "name": "jordans-portfolio-site",
    "version": "2.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "payload": "payload",
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "preview": "next build && next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "typecheck": "tsc --noEmit",
        "precommit": "pnpm run lint && pnpm run format && pnpm run typecheck",
