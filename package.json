{
    "name": "jordans-portfolio-site",
    "version": "2.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "payload": "payload",
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "preview": "next build && next start",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "typecheck": "tsc --noEmit",
        "precommit": "pnpm run lint && pnpm run format && pnpm run typecheck",
        "payload:generate-types": "payload generate:types",
        "payload:generate-importmap": "payload generate:importmap",
        "ci": "payload run scripts/check-no-dev-push.ts && payload migrate && pnpm build"
    },
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@payloadcms/db-postgres": "^3.92.0",
        "@payloadcms/next": "^3.92.0",
        "@payloadcms/richtext-lexical": "^3.92.0",
        "@payloadcms/storage-s3": "^3.92.0",
        "@react95/fonts": "^1.0.1",
        "@t3-oss/env-nextjs": "^0.13.11",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "graphql": "^16.14.2",
        "next": "16.4.3",
        "payload": "^3.92.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sharp": "^0.35.5",
        "shiki": "^4.5.0",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^24.13.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2005",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@12.15.0"
}
